  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "estateId": {
            "type": "string",
            "format": "uuid"
          },
          "blockId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "estateId",
          "blockId"
        ]
      },
      "SourceRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "collectionId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "bodyHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "collectionDate": {
            "type": "string",
            "format": "date"
          },
          "sourceAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$|\\+00:00$"
          },
          "availableAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$|\\+00:00$"
          }
        },
        "required": [
          "eventId",
          "collectionId",
          "version",
          "bodyHash",
          "collectionDate",
          "sourceAt",
          "availableAt"
        ]
      },
      "TargetResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "WET",
              "DRY"
            ]
          },
          "modelId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "comparatorModelId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "INSUFFICIENT_HISTORY",
              "INCOMPLETE_SOURCE",
              "PENDING_DRC"
            ]
          },
          "predictedKg": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "comparatorKg": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "maxItems": 1000
          },
          "anomalyStatus": {
            "type": "string",
            "enum": [
              "NOT_EVALUATED",
              "UNSCORED",
              "FLAGGED",
              "NOT_FLAGGED"
            ]
          },
          "actualKg": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "residualKg": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "thresholdKg": {
            "type": "string",
            "enum": [
              "1.000",
              "5.000"
            ]
          },
          "labelStatus": {
            "type": "string",
            "enum": [
              "NOT_EVALUATED",
              "ELIGIBLE",
              "INSUFFICIENT_HISTORY",
              "INCOMPLETE_SOURCE",
              "PENDING_DRC"
            ]
          },
          "labelSources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "target",
          "modelId",
          "comparatorModelId",
          "status",
          "predictedKg",
          "comparatorKg",
          "sources",
          "anomalyStatus",
          "actualKg",
          "residualKg",
          "thresholdKg",
          "labelStatus",
          "labelSources"
        ]
      },
      "Forecast": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "datasetId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "GENERATED_POINT_IN_TIME",
              "LIVE_FIRST_RECEIPT"
            ]
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$|\\+00:00$"
          },
          "targetDate": {
            "type": "string",
            "format": "date"
          },
          "estateTimezone": {
            "type": "string",
            "maxLength": 500
          },
          "labelAsOf": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$|\\+00:00$"
              },
              {
                "type": "null"
              }
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TargetResult"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "sourceDataProvenance": {
            "type": "string",
            "enum": [
              "SIMULATED"
            ]
          },
          "forecastProvenance": {
            "type": "string",
            "enum": [
              "PREDICTED"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "OBSERVED_ONLY"
            ]
          },
          "uncertainty": {
            "type": "string",
            "enum": [
              "UNCALIBRATED"
            ]
          }
        },
        "required": [
          "scope",
          "datasetId",
          "mode",
          "asOf",
          "targetDate",
          "estateTimezone",
          "labelAsOf",
          "targets",
          "sourceDataProvenance",
          "forecastProvenance",
          "coverage",
          "uncertainty"
        ]
      },
      "ModelRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": [
              "WET_KG_MEAN_7_V1",
              "DRY_KG_MEAN_7_V1",
              "WET_KG_LAST_DAY_V1",
              "DRY_KG_LAST_DAY_V1"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "WET",
              "DRY"
            ]
          },
          "featurePolicy": {
            "type": "string",
            "enum": [
              "SOURCE_AND_AVAILABILITY_BEFORE_LOCAL_MIDNIGHT_V1"
            ]
          },
          "labelPolicy": {
            "type": "string",
            "enum": [
              "AS_KNOWN_AT_NEXT_LOCAL_MIDNIGHT_V1"
            ]
          },
          "rounding": {
            "type": "string",
            "enum": [
              "SOURCE_ROUNDED_SUM_OUTPUT_HALF_UP_3_V1"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "OBSERVED_ONLY"
            ]
          },
          "uncertainty": {
            "type": "string",
            "enum": [
              "UNCALIBRATED"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "DEMO_ONLY"
            ]
          },
          "windowDays": {
            "type": "integer",
            "enum": [
              1,
              7
            ]
          },
          "policyVersion": {
            "type": "string",
            "enum": [
              "M4_BASELINES_V1"
            ]
          },
          "anomalyPolicy": {
            "type": "string",
            "enum": [
              "ABSOLUTE_FROZEN_RESIDUAL_STRICT_GREATER_V1"
            ]
          },
          "thresholdKg": {
            "type": "string",
            "enum": [
              "1.000",
              "5.000"
            ]
          }
        },
        "required": [
          "algorithm",
          "target",
          "featurePolicy",
          "labelPolicy",
          "rounding",
          "coverage",
          "uncertainty",
          "stage",
          "windowDays",
          "policyVersion",
          "anomalyPolicy",
          "thresholdKg"
        ]
      },
      "Metric": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "WET",
              "DRY"
            ]
          },
          "split": {
            "type": "string",
            "enum": [
              "TRAIN",
              "VALIDATION",
              "TEST"
            ]
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "MEAN_7",
              "LAST_DAY"
            ]
          },
          "scored": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "withheld": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "sumAbsoluteErrorKg": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "maeKg": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "withheldReasons": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 4
          }
        },
